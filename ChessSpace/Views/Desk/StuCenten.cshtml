<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StuCenten — Dashboard</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: 'Segoe UI', Roboto, sans-serif;
        }

        body {
            margin: 0;
            background: linear-gradient(135deg, #8ec5fc 0%, #e0c3fc 100%);
            color: #222;
            min-height: 100vh;
        }

        .wrap {
            max-width: 900px;
            margin: 0 auto;
            padding: 20px;
        }

        .header {
            text-align: center;
            margin-bottom: 20px;
        }

        .logo {
            width: 70px;
            transform: rotate(-12deg);
        }

        .main {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
        }

        .panel {
            background: #fff9;
            border-radius: 16px;
            box-shadow: 0 4px 10px #0002;
            padding: 20px;
            backdrop-filter: blur(8px);
        }

        .balance {
            font-weight: bold;
            margin-bottom: 6px;
        }

        .progress-wrap {
            background: #eee;
            border-radius: 8px;
            overflow: hidden;
            height: 12px;
            margin: 10px 0;
        }

        .progress-bar {
            background: linear-gradient(90deg, #22c55e, #86efac);
            height: 100%;
            width: 0;
            border-radius: 8px;
            transition: width 0.4s ease;
        }

        .btn {
            display: inline-block;
            background: #3b82f6;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 8px 14px;
            margin-top: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: 0.2s;
        }

            .btn:hover {
                transform: scale(1.05);
            }

            .btn.green {
                background: #22c55e;
            }

            .btn.red {
                background: #ef4444;
            }

        .txlist {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 10px;
            max-height: calc(3 * (50px + 8px));
            overflow-y: auto;
            padding-right: 4px;
        }

            .txlist::-webkit-scrollbar {
                display: none;
            }

        .tx {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #fff;
            padding: 8px 10px;
            border-radius: 10px;
            box-shadow: 0 1px 3px #0001;
            transition: 0.2s;
        }

            .tx:hover {
                transform: scale(1.02);
            }

            .tx .meta {
                font-size: 0.8em;
                color: #666;
            }

        .total {
            font-weight: bold;
            text-align: right;
            margin-top: 6px;
        }

        .budget-input {
            width: 100%;
            padding: 6px;
            border-radius: 8px;
            border: 1px solid #ccc;
            margin-bottom: 8px;
        }

        .coin {
            transition: transform 0.2s;
        }
    </style>
</head>
<body>
    <div class="wrap">
        <header class="header">
            <img src="~/images/StuCenten.png" alt="StuCenten logo" class="logo coin" />
            <h1>Welkom bij StuCenten</h1>
        </header>

        <main class="main">
            <section class="panel wallet">
                <h2>Rekeningen</h2>
                <div class="balance">Spaarrekening: € 3317,48</div>
                <div class="balance">Lopende rekening: € 58,42</div>
            </section>

            <section class="panel goal">
                <h3>Spaar­doel laptop</h3>
                <div class="progress-wrap">
                    <div id="progressBar" class="progress-bar" style="width: 23%;"></div>
                </div>
                <div id="goalMeta" class="meta">120 / 517 gespaard</div>
                <button id="saveNow" class="btn">+ €25 opsparen</button>
            </section>

            <section class="panel transactions-card">
                <h3>Transacties</h3>
                <div id="txList" class="txlist"></div>
                <button id="addTx" class="btn">Nieuwe transactie</button>
            </section>

            <section class="panel income-card">
                <h3>Maandelijkse Inkomsten</h3>
                <div id="incomeList" class="txlist"></div>
                <div id="incomeTotal" class="total"></div>
                <button id="addIncome" class="btn green">Nieuwe inkomsten</button>
            </section>

            <section class="panel expense-card">
                <h3>Vaste lasten</h3>
                <div id="expenseList" class="txlist"></div>
                <div id="expenseTotal" class="total"></div>
                <button id="addExpense" class="btn red">Nieuwe uitgave</button>
            </section>

            <section class="panel budget-card">
                <h3>Budget & Spaargeld</h3>
                <div id="budgetDiff" class="balance">Beschikbaar budget: € 0.00</div>

                <label for="customBudget" class="meta">Voer je eigen budget in (€):</label>
                <input type="number" id="customBudget" class="budget-input" placeholder="Bijv. 200">
                <button id="saveBudget" class="btn green">Budget opslaan</button>

                <div id="savingsLeft" class="balance">Over als spaargeld: € 0.00</div>

                <div class="progress-wrap">
                    <div id="budgetProgress" class="progress-bar"></div>
                </div>
                <div id="budgetPercent" class="meta">0% van budget benut</div>
            </section>
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
          const transactions = [
            { desc: 'Boodschappen - AH', amt: -18.40, date: 'Vandaag' },
            { desc: 'Studievergoeding', amt: 150.00, date: '2 dgn' },
          ];
          const incomes = [
            { desc: 'Bijbaan', amt: 80.00, date: 'Vandaag' },
            { desc: 'Stufi', amt: 300.00, date: '4 dgn' },
          ];
          const expenses = [
            { desc: 'Netflix', amt: -7.99, date: '2 dgn' },
            { desc: 'Lunch', amt: -6.20, date: '5 dgn' },
          ];

          const txList = document.getElementById('txList');
          const incomeList = document.getElementById('incomeList');
          const expenseList = document.getElementById('expenseList');
          const incomeTotal = document.getElementById('incomeTotal');
          const expenseTotal = document.getElementById('expenseTotal');
          const budgetDiff = document.getElementById('budgetDiff');
          const savingsLeft = document.getElementById('savingsLeft');
          const customBudgetInput = document.getElementById('customBudget');
          const budgetProgress = document.getElementById('budgetProgress');
          const budgetPercent = document.getElementById('budgetPercent');

          let savedBudget = 0;

          function formatMoney(n) {
            return (n < 0 ? '- ' : '+ ') + '€ ' + Math.abs(n).toFixed(2);
          }

          function calcTotal(data) {
            return data.reduce((sum, t) => sum + t.amt, 0);
          }

          function render(list, data) {
            list.innerHTML = '';
            data.forEach((t, i) => {
              const el = document.createElement('div');
              el.className = 'tx';
              el.innerHTML = `
                <div>
                  <div class="desc" contenteditable="true">${t.desc}</div>
                  <div class='meta'>${t.date}</div>
                </div>
                <div style='text-align:right'>
                  <div class='amount' contenteditable="true" style='font-weight:700;color:${t.amt < 0 ? "#ef4444" : "#059669"}'>${formatMoney(t.amt)}</div>
                  <div class='meta'>${t.amt < 0 ? "Uitgave" : "Inkomen"}</div>
                </div>`;
              list.appendChild(el);

              el.querySelector('.desc').addEventListener('blur', e => {
                data[i].desc = e.target.textContent.trim();
              });
              el.querySelector('.amount').addEventListener('blur', e => {
                const v = e.target.textContent.replace(/[^\d-.,]/g, '').replace(',', '.');
                data[i].amt = parseFloat(v) || 0;
                updateAll();
              });
            });
          }

          function updateTotals() {
            const totalIncomes = calcTotal(incomes);
            const totalExpenses = calcTotal(expenses);
            incomeTotal.textContent = 'Totaal: € ' + totalIncomes.toFixed(2);
            expenseTotal.textContent = 'Totaal: € ' + Math.abs(totalExpenses).toFixed(2);

            const diff = totalIncomes + totalExpenses; // expenses zijn negatief
            budgetDiff.textContent = 'Beschikbaar budget: € ' + diff.toFixed(2);

            const leftover = diff - savedBudget;
            savingsLeft.textContent = 'Over als spaargeld: € ' + leftover.toFixed(2);

            // Update progress bar
            const percent = Math.min(100, Math.max(0, (savedBudget > 0 ? (diff / savedBudget * 100) : 0)));
            budgetProgress.style.width = percent + '%';
            budgetPercent.textContent = percent.toFixed(1) + '% van budget benut';
          }

          function updateAll() {
            render(txList, transactions);
            render(incomeList, incomes);
            render(expenseList, expenses);
            updateTotals();
          }

          updateAll();

          document.getElementById('addTx').addEventListener('click', () => {
            transactions.unshift({ desc: 'Nieuwe transactie', amt: 0, date: 'Nu' });
            updateAll();
          });
          document.getElementById('addIncome').addEventListener('click', () => {
            incomes.unshift({ desc: 'Nieuwe inkomsten', amt: 0, date: 'Nu' });
            updateAll();
          });
          document.getElementById('addExpense').addEventListener('click', () => {
            expenses.unshift({ desc: 'Nieuwe uitgave', amt: -0, date: 'Nu' });
            updateAll();
          });

          document.getElementById('saveBudget').addEventListener('click', () => {
            savedBudget = parseFloat(customBudgetInput.value) || 0;
            updateTotals();
          });

          document.getElementById('saveNow').addEventListener('click', () => {
            const p = document.getElementById('progressBar');
            const cur = parseFloat(p.style.width);
            p.style.width = Math.min(96, cur + 6) + '%';
            document.getElementById('goalMeta').textContent =
              Math.round(parseFloat(p.style.width) / 100 * 517) + ' / 517 gespaard';
          });

          const coin = document.querySelector('.coin');
          window.addEventListener('mousemove', e => {
            const x = (e.clientX / window.innerWidth - 0.5) * 18;
            const y = (e.clientY / window.innerHeight - 0.5) * 12;
            coin.style.transform = `translate(${x}px, ${y}px) rotate(-12deg)`;
          });
        });
    </script>
</body>
</html>
